# Independent Coolify image. Does NOT deploy or turn indexing on.
# Lockfile adapted from the verified DGI Next.js workspace dependency graph.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
# Isolated npm cache survives BuildKit retries for this project only.
# Extra fetch retries address transient registry.npmjs.org ETIMEDOUT during pnpm bootstrap.
# No registry mirrors, global Docker settings or changes to the running application.
RUN --mount=type=cache,id=consumer-rights-npm-cache,target=/root/.npm,sharing=locked \
    timeout -s TERM -k 10s 600s \
    npm install -g pnpm@10.0.0 \
      --prefer-offline \
      --no-audit \
      --no-fund \
      --fetch-retries=4 \
      --fetch-retry-mintimeout=10000 \
      --fetch-retry-maxtimeout=60000 \
      --fetch-timeout=90000

COPY package.json pnpm-lock.yaml ./
# Keep a dedicated pnpm store across BuildKit retries without sharing it with other sites.
# Limit simultaneous downloads on the VPS and fail explicitly if the registry stalls.
# BuildKit caches the already-fetched packages if a deploy must be retried.
RUN --mount=type=cache,id=consumer-rights-pnpm-store,target=/pnpm/store,sharing=locked \
    timeout -s TERM -k 10s 900s \
    pnpm install --frozen-lockfile \
      --store-dir=/pnpm/store \
      --network-concurrency=2 \
      --fetch-retries=4 \
      --fetch-timeout=90000 \
      --reporter=append-only
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/.next/standalone ./
# Next.js standalone omits public/ by default; copy verification assets into the runtime image.
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
# Built-in Node.js readiness probe. No curl/wget packages required in the runner.
# Failure makes the container unhealthy; no production release/SEO flags are changed.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
