# Independent Coolify image. Does NOT deploy or turn indexing on.
# Lockfile adapted from the verified DGI Next.js workspace dependency graph.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN npm install -g pnpm@10.0.0
COPY package.json pnpm-lock.yaml ./
# Keep a dedicated pnpm store across BuildKit retries without sharing it with other sites.
# Limit simultaneous downloads on the VPS and fail explicitly if the registry stalls.
# BuildKit caches the already-fetched packages if a deploy must be retried.
RUN --mount=type=cache,id=consumer-rights-pnpm-store,target=/pnpm/store,sharing=locked \
    timeout -s TERM -k 10s 600s \
    pnpm install --frozen-lockfile \
      --store-dir=/pnpm/store \
      --network-concurrency=4 \
      --fetch-retries=1 \
      --fetch-timeout=30000 \
      --reporter=append-only
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
